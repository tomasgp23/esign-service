# Copy this file to .env and fill in real values before starting the server.

# Port the Node process listens on locally.
PORT=4100

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# Public base URL signer links are built from, e.g. https://se-00065.tailcde110.ts.net:8443
PUBLIC_BASE_URL=http://localhost:4100

# Pepper mixed into OTP code hashes (separate from the DB, never stored alongside it).
OTP_PEPPER=change-me-too

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="E-Sign <no-reply@example.com>"

# --- SMS (Twilio-compatible REST API, e.g. Twilio or TextGrid) ---
SMS_API_BASE=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
